{
  "permissions": {
    "ask": [
      "Edit(utils/canonical-match-result.ts)",
      "Edit(utils/canonical-match-result-storage.ts)",
      "Edit(utils/event-dedupe.ts)",
      "Edit(utils/websocket-helpers.ts)",
      "Edit(components/Settings/PrecisionMap.vue)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/home/arnonym2302/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "/home/arnonym2302/.local/bin/graphify hook-guard read --strict"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}