#!/bin/sh
# PKG-7 / D2: protected-core trailer guard for pushed commits (see scripts/core-guard.mjs, docs/PROTECTED_CORE_ENFORCEMENT.md).
dir=$(cd "$(dirname "$0")" && pwd) || exit 1
command -v node >/dev/null 2>&1 || { echo "core-guard: node not found in PATH, refusing (fail closed)." >&2; exit 1; }
exec node "$dir/../core-guard.mjs" pre-push "$@"
