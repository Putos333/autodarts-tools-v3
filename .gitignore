# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.output
stats.html
.wxt
web-ext.config.ts
test-results
playwright-report

# WXT auto-generated type definitions (regenerated on `yarn postinstall` -> `wxt prepare`)
auto-imports.d.ts
components.d.ts

# Yarn Classic install-state cache (regenerated automatically)
.yarn/install-state.gz

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env
.env.*
!.env.example

# Signing certificates and provisioning profiles
*.p8
*.p12
*.cer
*.provisionprofile
*.mobileprovision
*.certSigningRequest

git2md

# Ruflo local secrets and runtime data
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/

# graphify knowledge graph output
graphify-out/

# Local AI/tooling runtime data
ruvector.db

# claude-flow/ruflo generated runtime state (Setup 2.0 Wave 5 — MCP registration
# removed in Wave 2; these SQLite DB/WAL/SHM files are regenerable, non-authoritative
# runtime state, not source. .swarm/schema.sql (a schema definition, not generated
# data) is intentionally NOT ignored here.
.swarm/*.db
.swarm/*.db-wal
.swarm/*.db-shm

# ProjectAtlas generated runtime state (Setup 2.0 Package 6): SQLite index DB with
# WAL/SHM sidecars and the graph-stage lock. Regenerable, not source. The tracked
# .projectatlas/*.toml, *.toon and *.mcp.json / *.opencode.json configs are
# intentionally NOT ignored here.
.projectatlas/projectatlas.db
.projectatlas/projectatlas.db-wal
.projectatlas/projectatlas.db-shm
.projectatlas/repository-graph-stage.lock

# ruflo/claude-flow generated runtime state (Setup 2.0 Package 8): agent/metrics/
# policy/security snapshots, the npx resolver cache (contains a local absolute
# path), one browser-session .rvf and the ruvector learning state. Regenerable,
# not source. .claude-flow/config.yaml, CAPABILITIES.md and .claude-flow/.gitignore
# stay tracked (ruflo configuration/docs); runtime-artifacts/ is intentionally
# NOT ignored here.
.claude-flow/agents/
.claude-flow/metrics/
.claude-flow/policy/
.claude-flow/security/
.claude-flow/memory-package.json
.ruflo/browser-sessions/
.ruvector/intelligence.json
