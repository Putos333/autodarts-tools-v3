+export function discordWebhooksOnRemove(): void {
+  if (startButtonObserver !== null) {
+    startButtonObserver.disconnect();
+    startButtonObserver = null;
+  }
+
+  if (autoStartTimer !== null) {
+    clearTimeout(autoStartTimer);
+    autoStartTimer = null;
